{
  "name": "roadcast",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js dev",
    "build": "bun --bun ./node_modules/vite/bin/vite.js build",
    "start": "bun server.mjs",
    "lint": "bun --bun ./node_modules/eslint/bin/eslint.js \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"drizzle.config.ts\"",
    "check:types": "bun --bun ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun run test:unit && bun run test:integration && bun run test:security",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:security": "bun test tests/security",
    "test:e2e": "bun --bun ./node_modules/@playwright/test/cli.js test",
    "test:a11y": "bun --bun ./node_modules/@playwright/test/cli.js test --grep @a11y",
    "db:generate": "bun --bun ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "bun --bun ./node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.16.0",
    "@solidjs/start": "^2.0.5",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-youtube": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "drizzle-orm": "^0.44.7",
    "lucide-solid": "^1.49.0",
    "nitro": "^3.0.260903-beta",
    "postgres": "^3.4.7",
    "solid-js": "^1.9.15",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "@types/bun": "^1.3.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "eslint-plugin-solid": "^0.14.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
